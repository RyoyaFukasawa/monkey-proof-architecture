{
  "name": "create-monkey-proof",
  "version": "0.1.0",
  "description": "MPA (Monkey-Proof Architecture) を新規/既存プロジェクトに導入し、使う AI ツールへ /mpa 一式を展開する。",
  "type": "module",
  "bin": {
    "create-monkey-proof": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "dev": "node --loader tsx src/cli.ts",
    "pretest": "npm run build",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "monkey-proof",
    "monkey-proof-architecture",
    "mpa",
    "architecture",
    "fsd",
    "clean-architecture",
    "scaffolding",
    "ai-agents"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.41",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0"
  }
}

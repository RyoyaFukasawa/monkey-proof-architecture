{
  "//": "create-mpa が templates/hooks/settings.example.json から生成。MPA hooks の登録。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/bin/mpa-pre-write.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/bin/mpa-stop-review.sh"
          }
        ]
      }
    ]
  }
}

{
  "//": "MPA hooks の登録例。リポジトリ直下の .claude/settings.json にこの hooks ブロックをマージして使う。",
  "//paths": "command のパスはリポジトリ構成に合わせて調整すること（ここでは mpa/ をルートと仮定）。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.ai/hooks/bin/mpa-pre-write.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.ai/hooks/bin/mpa-stop-review.sh"
          }
        ]
      }
    ]
  }
}
